{% assign heading = include.heading | default: 'h2' %}
{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% else %}
  {% assign project_href = project.url | relative_url %}
{% endif %}
{% assign project_thumb = project.thumbnail | default: project.img %}
<article class="project-card" data-reveal>
  {% if project_thumb %}
    <div class="project-card__media">
      {%
        include figure.liquid
        loading="lazy"
        path=project_thumb
        sizes="(min-width: 992px) 360px, (min-width: 576px) 50vw, 100vw"
        alt=""
        class="project-card__img"
      %}
    </div>
  {% endif %}
  <div class="project-card__body">
    {% if project.date %}
      <p class="project-card__meta">
        <time datetime="{{ project.date | date_to_xmlschema }}">{{ project.date | date: '%b %Y' }}</time>
      </p>
    {% endif %}
    <{{ heading }} class="project-card__title">
      <a class="project-card__link" href="{{ project_href }}">{{ project.title }}</a>
    </{{ heading }}>
    {% if project.description %}
      <p class="project-card__desc">{{ project.description }}</p>
    {% endif %}
    <div class="project-card__footer">
      <span class="project-card__cta" aria-hidden="true">View project <i class="ti ti-arrow-up-right"></i></span>
      {% if project.github %}
        <span class="project-card__repo">
          <a href="{{ project.github }}" aria-label="Code repository for {{ project.title }}"
            ><i class="fa-brands fa-github" aria-hidden="true"></i
          ></a>
          {% if project.github_stars %}
            <span class="stars" title="GitHub Stars">
              <i class="fa-solid fa-star" aria-hidden="true"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        </span>
      {% endif %}
    </div>
  </div>
</article>
