{% capture footer_meta %}
  &copy; {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">{{ footer_meta }}</div>
  </footer>
{% else %}
  <footer class="site-footer sticky-bottom" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include scripts/newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="site-footer__top">
        <div class="site-footer__id">
          <a class="brand" href="{{ site.baseurl }}/">
            <span class="brand__mark" aria-hidden="true">
              {{- site.first_name | slice: 0 -}}
              {{- site.last_name | slice: 0 -}}
            </span>
            <span class="brand__name">
              {{- site.first_name }}
              {{ site.last_name -}}
            </span>
          </a>
        </div>
        <div class="social-row" aria-label="Social links">{% include social.liquid %}</div>
      </div>
      <div class="site-footer__meta">{{ footer_meta }}</div>
    </div>
  </footer>
{% endif %}
